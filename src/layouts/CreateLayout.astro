---
import { Sidebar } from "@/app/layout";
import "@/styles/global.css";
const { title } = Astro.props;
import CoinsAndHearts from "@/components/CoinsAndHearts";
import ContentSwitcher from "@/components/MainContent";
import { ClientRouter } from "astro:transitions";
import { ClerkProvider } from "@clerk/clerk-react";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Schreib-recht-logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />

  </head>
  <body>
    <Sidebar>
    <ClerkProvider
    publishableKey={import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY}
    client:only="react"
  >
    <ContentSwitcher client:only="react" />
  </ClerkProvider>
</Sidebar>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  body::-webkit-scrollbar {
    display: none;
  }
</style>
