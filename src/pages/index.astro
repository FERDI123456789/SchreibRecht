---
import Layout from "../layouts/Layout.astro";
import "@/styles/global.css";
import { ArrowRight } from "lucide-react";
---

<Layout
  title="SchreibRecht - Verbessere dein Schreiben und Lesen einfacher denn je!"
>
  <style>
    body {
      overflow: hidden;
    }
    .interactive-svg {
      transition: transform 0.3s ease;
    }
  </style>
  <div class="bg-white">
    <header
      class="relative mt-32 overflow-x-hidden overflow-y-hidden rounded-b-[20%] bg-primary/10 shadow-lg"
    >
      <div class="relative px-5 md:px-10">
        <div class="mx-auto w-full max-w-2xl">
          <div
            class="z-10 mx-auto flex w-full max-w-4xl flex-col items-center py-12 text-center md:py-16 lg:pb-44 lg:pt-24"
          >
            <h1
              data-aos="fade-up"
              data-aos-duration="900"
              id="main-title"
              class="aos-init aos-animate z-10 mb-4 mt-6 cursor-default text-5xl font-extrabold uppercase text-[#091e3b] [text-shadow:_2px_2px_4px_rgba(0,0,0,0.4)] md:text-7xl"
            >
              Wie Duolingo - nur für LRS.
            </h1>
            <p
              data-aos="fade-up"
              data-aos-duration="900"
              class="aos-init aos-animate z-10 mb-10 max-w-md cursor-default text-[#091e3b]"
            >
              Discover a wealth of valuable no-code tutorialsin our
              comprehensive tutorial hub.
            </p>
            <div class="mb-10 flex gap-4">
              <a
                href="/auth/signin"
                class="group inline-block rounded-md border border-transparent bg-primary px-8 py-4 text-center font-extrabold uppercase text-white transition-all duration-200 hover:-translate-y-1 hover:border-primary hover:bg-transparent hover:text-primary hover:shadow-md"
              >
                Jetzt Kostenlos Starten
                <ArrowRight
                  className="mb-0.5 inline transition-all duration-200 group-hover:-rotate-[90deg]"
                  size={20}
                />
              </a>
              <a
                href="/auth/signin"
                class="group inline-block rounded-md border border-transparent px-8 py-4 text-center font-extrabold uppercase text-secondary transition-all duration-200 hover:-translate-y-1 hover:border-secondary/90 hover:bg-transparent hover:text-secondary hover:shadow-md"
              >
                Jetzt Pro Werden
                <ArrowRight
                  className="mb-0.5 inline transition-all duration-200 group-hover:-rotate-[90deg]"
                  size={20}
                />
              </a>
            </div>
          </div>
        </div>
        <div
          class="absolute bottom-32 right-0 w-16 md:bottom-0 md:w-28 lg:w-48"
        >
          <img
            src="https://assets-global.website-files.com/655eda66dab018e613baf5ff/655f2b28c57aa4c75abf6974_guide-svg4.svg"
            loading="eager"
            width="168"
            alt=""
            class="interactive-svg w-full rounded-full hover:rotate-3"
          /><img
            src="https://assets-global.website-files.com/655eda66dab018e613baf5ff/655eedbe0ca0432ba7fd096f_guide-svg2.svg"
            loading="eager"
            width="168"
            alt=""
            class="interactive-svg w-full"
          />
        </div>
        <div
          class="absolute bottom-auto left-0 top-0 w-28 md:bottom-0 md:top-auto md:w-56 lg:w-96"
        >
          <img
            src="https://assets-global.website-files.com/655eda66dab018e613baf5ff/655eedbe09e863ce99b749af_guide-svg3.svg"
            loading="eager"
            alt=""
            class="interactive-svg w-full rounded-full"
          />
          <img
            src="https://assets-global.website-files.com/655eda66dab018e613baf5ff/655f2a8686fbbf271f061f15_guide-hero-svg.svg"
            loading="eager"
            alt=""
            class="is-fixed-width interactive-svg w-full lg:w-72"
          />
        </div>
      </div>
    </header>
  </div>

  <section class="bg-white">
    <!-- Container -->
    <div class="px-5 py-16 md:px-10 md:py-20">
      <div class="mx-auto w-full max-w-7xl bg-gray-100 px-4 py-32 text-center">
        <!-- Title -->
        <h2
          class="mx-auto mb-6 max-w-3xl flex-col text-3xl font-bold md:mb-10 md:text-5xl md:leading-snug lg:mb-12"
        >
          Lightning Fast Webflow Dev Made Easy
        </h2>
        <ul
          class="mx-auto mb-8 flex flex-col items-center justify-center gap-5 sm:flex-row sm:gap-8 md:gap-10 lg:mb-12"
        >
          <li class="flex items-center">
            <img
              src="https://assets.website-files.com/6458c625291a94a195e6cf3a/6458c625291a9473e2e6cf65_tick-circle.svg"
              alt=""
              class="mr-2 h-8 w-8"
            />
            <p class="text-sm sm:text-base">300+ UI Blocks</p>
          </li>
          <li class="flex items-center">
            <img
              src="https://assets.website-files.com/6458c625291a94a195e6cf3a/6458c625291a9473e2e6cf65_tick-circle.svg"
              alt=""
              class="mr-2 h-8 w-8"
            />
            <p class="text-sm sm:text-base">Fully responsive</p>
          </li>
          <li class="flex items-center">
            <img
              src="https://assets.website-files.com/6458c625291a94a195e6cf3a/6458c625291a9473e2e6cf65_tick-circle.svg"
              alt=""
              class="mr-2 h-8 w-8"
            />
            <p class="text-sm sm:text-base">Just copy & paste</p>
          </li>
        </ul>
        <a
          href="javascript:void(0);"
          class="mb-4 inline-block items-center bg-black px-6 py-3 text-center font-semibold text-white"
        >
          Get Started
        </a>
        <p class="text-sm sm:text-base">No credit card required.</p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <!-- Container -->
    <div class="px-5 py-16 md:px-10 md:py-20">
      <div class="mx-auto w-full max-w-7xl bg-gray-100 px-4 py-32 text-center">
        <!-- Title -->
        <h2
          class="mx-auto mb-6 max-w-3xl flex-col text-3xl font-bold md:mb-10 md:text-5xl md:leading-snug lg:mb-12"
        >
          Lightning Fast Webflow Dev Made Easy
        </h2>
        <ul
          class="mx-auto mb-8 flex flex-col items-center justify-center gap-5 sm:flex-row sm:gap-8 md:gap-10 lg:mb-12"
        >
          <li class="flex items-center">
            <img
              src="https://assets.website-files.com/6458c625291a94a195e6cf3a/6458c625291a9473e2e6cf65_tick-circle.svg"
              alt=""
              class="mr-2 h-8 w-8"
            />
            <p class="text-sm sm:text-base">300+ UI Blocks</p>
          </li>
          <li class="flex items-center">
            <img
              src="https://assets.website-files.com/6458c625291a94a195e6cf3a/6458c625291a9473e2e6cf65_tick-circle.svg"
              alt=""
              class="mr-2 h-8 w-8"
            />
            <p class="text-sm sm:text-base">Fully responsive</p>
          </li>
          <li class="flex items-center">
            <img
              src="https://assets.website-files.com/6458c625291a94a195e6cf3a/6458c625291a9473e2e6cf65_tick-circle.svg"
              alt=""
              class="mr-2 h-8 w-8"
            />
            <p class="text-sm sm:text-base">Just copy & paste</p>
          </li>
        </ul>
        <a
          href="javascript:void(0);"
          class="mb-4 inline-block items-center bg-black px-6 py-3 text-center font-semibold text-white"
        >
          Get Started
        </a>
        <p class="text-sm sm:text-base">No credit card required.</p>
      </div>
    </div>
  </section>
</Layout>
